# Lecture de la valeur ADC et reglage du volume / rapport cyclique
def Mesurer():
    Mesure = int(Valeur.read_u16()/30)
    PWMSound.duty_u16(Mesure)
    
# Function callback pour le timer
def callback_adc(t):
    Mesurer()

# Interruption du bouton avec gestion de l'anti-rebond
def isr_bouton(pin):
    global NBR, lastChange
    now = utime.ticks_ms()
    
    # Verification anti-rebond (500 ms)
    if utime.ticks_diff(now, lastChange) > 500:
        lastChange = now
        
        if pin.value() == 1:
            NBR = NBR+1
            if NBR == 2:
                NBR = 0;
            print(NBR)

# Fonction pour jouer une melodie
def play(MUSIC):
    taille = len(MUSIC)
    current_song = NBR
    for i in range(taille):
        # Permet de couper le morceau si le bouton est appuye
        if NBR != current_song:
            break
        
        sound = MUSIC[i][0] 
        sleep = MUSIC[i][1]
        
        # Pause ou note
        if sound == 0:
            PWMSound.duty_u16(0)            # Silence
            LED.value(0)
        else:
            PWMSound.freq(sound)            # Ajuste la frequence de la note
            LED.value(1)                    # Allume la LED sur la note
            
        utime.sleep_ms(sleep)
        LED.value(0)

# Initialisation du timer (echantillonnage ADC a 100 Hz)
timer_adc.init(freq=100, mode=Timer.PERIODIC, callback=callback_adc)

# Interruption sur front montant du bouton
BTN.irq(trigger=machine.Pin.IRQ_RISING, handler=isr_bouton)
    
# Boucle principale : alterne entre les musiques selon la valeur de NBR
while True:
    if NBR == 0:
        play(MARIO)
    if NBR == 1:
        play(ZELDA)
