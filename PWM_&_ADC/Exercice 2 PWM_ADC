def Mesurer():
    Mesure = int(Valeur.read_u16()/30)
    PWMSound.duty_u16(Mesure)
    
def callback_adc(t):
    Mesurer()

def isr_bouton(pin):
    global NBR, lastChange
    now = utime.ticks_ms()
    
    if utime.ticks_diff(now, lastChange) > 500:
        lastChange = now
        
        if pin.value() == 1:
            NBR = NBR+1
            if NBR == 2:
                NBR = 0;
            print(NBR)

def play(MUSIC):
    taille = len(MUSIC)
    current_song = NBR
    for i in range(taille):
        if NBR != current_song:
            break
        
        sound = MUSIC[i][0] 
        sleep = MUSIC[i][1]
        
        if sound == 0:
            PWMSound.duty_u16(0)
            LED.value(0)
        else:
            PWMSound.freq(sound)
            LED.value(1)
            
        utime.sleep_ms(sleep)
        LED.value(0)

timer_adc.init(freq=100, mode=Timer.PERIODIC, callback=callback_adc)
BTN.irq(trigger=machine.Pin.IRQ_RISING, handler=isr_bouton)
    
while True:
    if NBR == 0:
        play(MARIO)
    if NBR == 1:
        play(ZELDA)
