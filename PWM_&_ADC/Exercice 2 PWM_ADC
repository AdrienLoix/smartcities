import machine
import utime
from machine import ADC
from machine import Pin, PWM, Timer
from utime import sleep

# Configuration des E/S et des peripheriques
Valeur = ADC(2)                             # Potentiometre / capteur sur ADC2
PWMSound = PWM(Pin(27))                     # Buzzer sur GP27 (PWM)
BTN = machine.Pin(16,machine.Pin.IN)        # Bouton poussoir sur GP16
LED = machine.Pin(18,machine.Pin.OUT)       # LED d'indication sur GP18
timer_adc = Timer()                         # Timer pour la lecture ADC
NBR = 0                                     # Selection du morceau (0 = Mario, 1 = Zelda)
lastChange = 0                              # Anti-rebond du bouton

